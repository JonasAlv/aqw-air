// ========================================================
// Script: Diabolical Reputation Farm (.hxs)
// Farms Diabolical Reputation to Rank 10
// Quest: 7877
// Prerequisite: Quests 7875 and 7876 completed
// ========================================================

function onStart() {
    if (factionRank("Diabolical") >= 10) {
        msg("Diabolical Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(7877)) {
        msg("Prerequisite missing: Quest 7877 is locked. Complete quests 7875 and 7876 in /timevoid and /twilightedge first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("solo");
    ensureMap("mudluk");
}

function onTick() {
    if (factionRank("Diabolical") >= 10) {
        msg("Diabolical Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("mudluk");
    ensureQuest(7877);

    if (!hunt("Tiger Leech", "Swamped Leech Tooth", 1)) return;

    if (isQuestComplete(7877)) {
        ensureComplete(7877);
    }
}

function onStop() {
    stopCombat();
}
