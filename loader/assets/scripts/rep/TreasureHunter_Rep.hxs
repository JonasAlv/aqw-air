// ========================================================
// Script: Treasure Hunter Reputation Farm (.hxs)
// Farms Treasure Hunter Reputation to Rank 10
// Quest: 6593
// Prerequisite: Treasure Hunter quests unlocked
// ========================================================

function onStart() {
    if (factionRank("TreasureHunter") >= 10) {
        msg("Treasure Hunter Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(6593)) {
        msg("Prerequisite missing: Quest 6593 is locked. Unlock Treasure Hunter quests first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("farm");
    ensureMap("stalagbite");
    autoQuest([6593]);
}

function onTick() {
    if (factionRank("TreasureHunter") >= 10) {
        msg("Treasure Hunter Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("stalagbite");
    if (!hunt("Balboa", "Super Specific Rock", 1)) return;
}

function onStop() {
    stopAutoQuest();
    stopCombat();
}
