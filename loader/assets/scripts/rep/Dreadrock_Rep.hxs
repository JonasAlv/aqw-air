// ========================================================
// Script: Dreadrock Reputation Farm (.hxs)
// Farms Dreadrock Reputation to Rank 10
// Quests: 4862, 4863, 4865, 4868
// Prerequisite: Dreadrock quests unlocked
// ========================================================

function onStart() {
    if (factionRank("Dreadrock") >= 10) {
        msg("Dreadrock Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(4862)) {
        msg("Prerequisite missing: Quest 4862 is locked. Unlock Dreadrock quests first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("farm");
    ensureMap("dreadrock", "r3", "Bottom");
    autoQuest([4862, 4863, 4865, 4868]);
}

function onTick() {
    if (factionRank("Dreadrock") >= 10) {
        msg("Dreadrock Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("dreadrock", "r3", "Bottom");
    ensureCombat();
}

function onStop() {
    stopAutoQuest();
    stopCombat();
}
