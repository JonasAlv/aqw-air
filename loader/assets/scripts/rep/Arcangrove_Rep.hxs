// ========================================================
// Script: Arcangrove Reputation Farm (.hxs)
// Farms Arcangrove Reputation to Rank 10
// Quests: 794, 795, 796, 797, 798, 799, 800, 801
// ========================================================

function onStart() {
    if (factionRank("Arcangrove") >= 10) {
        msg("Arcangrove Reputation is already Rank 10.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("farm");
    ensureMap("arcangrove", "LeftBack", "Left");
    autoQuest([794, 795, 796, 797, 798, 799, 800, 801]);
}

function onTick() {
    if (factionRank("Arcangrove") >= 10) {
        msg("Arcangrove Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("arcangrove");

    // Alternate between Gorillaphants and Seed Spitters for Rayst's quests
    if (!hunt("Gorillaphant", 5)) return;
    if (!hunt("Seed Spitter", 5)) return;
}

function onStop() {
    stopAutoQuest();
    stopCombat();
}
