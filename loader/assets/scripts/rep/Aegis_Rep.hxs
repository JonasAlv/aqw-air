// ========================================================
// Script: Aegis Reputation Farm (.hxs)
// Farms Aegis Reputation to Rank 10
// Quests: 4900, 4910, 4914
// Prerequisite: Skytower Aegis intro quests completed
// ========================================================

function onStart() {
    if (factionRank("Aegis") >= 10) {
        msg("Aegis Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(4900)) {
        msg("Prerequisite missing: Quest 4900 is locked. Complete Skytower Aegis intro quests first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("farm");
    ensureMap("skytower");
    autoQuest([4900, 4910, 4914]);
}

function onTick() {
    if (factionRank("Aegis") >= 10) {
        msg("Aegis Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("skytower");
    if (!hunt("Seraphic Assassin", 5)) return;
    if (!hunt("Virtuous Warrior", 5)) return;
}

function onStop() {
    stopAutoQuest();
    stopCombat();
}
