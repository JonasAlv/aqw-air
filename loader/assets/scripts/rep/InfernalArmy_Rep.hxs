// ========================================================
// Script: Infernal Army Reputation Farm (.hxs)
// Farms Infernal Army Reputation to Rank 10
// Quest: 5707 (Practice Time)
// Prerequisite: Infernal Army intro in /dreadfire completed
// ========================================================

function onStart() {
    if (factionRank("Infernal Army") >= 10) {
        msg("Infernal Army Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(5707)) {
        msg("Prerequisite missing: Quest 5707 is locked. Complete Infernal Army intro in /dreadfire first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("farm");
    ensureMap("dreadfire", "r10", "Left");
    autoQuest([5707]);
}

function onTick() {
    if (factionRank("Infernal Army") >= 10) {
        msg("Infernal Army Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("dreadfire", "r10", "Left");
    if (!hunt("Living Brimstone", "Living Brimstone Defeated", 1)) return;
}

function onStop() {
    stopAutoQuest();
    stopCombat();
}
