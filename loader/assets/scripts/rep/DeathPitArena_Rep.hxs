// ========================================================
// Script: Death Pit Arena Reputation Farm (.hxs)
// Farms Death Pit Arena Reputation to Rank 10
// Quest: 5153
// Prerequisite: Death Pit Arena saga completed up to quest 5153
// ========================================================

function onStart() {
    if (factionRank("Death Pit Arena") >= 10) {
        msg("Death Pit Arena Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(5153)) {
        msg("Prerequisite missing: Quest 5153 is locked. Complete the Death Pit Arena saga in /deathpit first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("solo");
    ensureMap("deathpit");
}

function onTick() {
    if (factionRank("Death Pit Arena") >= 10) {
        msg("Death Pit Arena Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("deathpit");
    ensureQuest(5153);

    if (!hunt("General Hun'Gar", "General Hun'Gar Defeated", 1)) return;

    if (isQuestComplete(5153)) {
        ensureComplete(5153);
    }
}

function onStop() {
    stopCombat();
}
