// ========================================================
// Script: Druid Grove Reputation Farm (.hxs)
// Farms Druid Grove Reputation to Rank 10
// Quest: 3049 (Help Professor Maedoc)
// Prerequisite: Druid Grove intro in /bloodtusk completed
// ========================================================

function onStart() {
    if (factionRank("Druid Grove") >= 10) {
        msg("Druid Grove Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(3049)) {
        msg("Prerequisite missing: Quest 3049 is locked. Complete Druid Grove intro in /bloodtusk first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("farm");
    ensureMap("bloodtusk");
    autoQuest([3049]);
}

function onTick() {
    if (factionRank("Druid Grove") >= 10) {
        msg("Druid Grove Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("bloodtusk");
    if (!hunt("Crystal-Rock", 5)) return;
}

function onStop() {
    stopAutoQuest();
    stopCombat();
}
