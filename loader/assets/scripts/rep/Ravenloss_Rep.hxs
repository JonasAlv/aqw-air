// ========================================================
// Script: Ravenloss Reputation Farm (.hxs)
// Farms Ravenloss Reputation to Rank 10
// Quest: 3445 (Slay the Spiderkin)
// Prerequisite: Ravenloss storyline completed up to quest 3445
// ========================================================

function onStart() {
    if (factionRank("Ravenloss") >= 10) {
        msg("Ravenloss Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(3445)) {
        msg("Prerequisite missing: Quest 3445 is locked. Complete the Ravenloss storyline first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("farm");
    ensureMap("twilightedge");
}

function onTick() {
    if (factionRank("Ravenloss") >= 10) {
        msg("Ravenloss Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("twilightedge");
    ensureQuest(3445);

    if (!hunt("ChaosWeaver Mage", "ChaosWeaver Slain", 10)) return;

    if (isQuestComplete(3445)) {
        ensureComplete(3445);
    }
}

function onStop() {
    stopCombat();
}
