// ========================================================
// Script: Skyguard Reputation Farm (.hxs)
// Farms Skyguard Reputation to Rank 10
// Quests: 1326 (Membership Dues) or 883 (Sky Pirates)
// Prerequisite: Member-Only
// ========================================================

function onStart() {
    if (factionRank("Skyguard") >= 10) {
        msg("Skyguard Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isMember()) {
        msg("Prerequisite missing: Skyguard Reputation is Member-Only.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("farm");
}

function onTick() {
    if (factionRank("Skyguard") >= 10) {
        msg("Skyguard Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    // Fast method: Super-Fan Swag Token A via Membership Dues (Quest 1326)
    if (hasItem("Super-Fan Swag Token A")) {
        ensureMap("collection");
        ensureQuest(1326);
        ensureComplete(1326);
        return;
    }

    // Farming method: Quest 883 (Sky Pirates) in /airship
    ensureMap("airship");
    ensureQuest(883);
    if (!hunt("Sky Pirate Draconian", 5)) return;
    if (isQuestComplete(883)) ensureComplete(883);
}

function onStop() {
    stopCombat();
}
