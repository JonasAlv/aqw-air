// ========================================================
// Script: Lycan Reputation Farm (.hxs)
// Farms Lycan Reputation to Rank 10
// Quest: 537 (Sanguine)
// Prerequisite: Lycan storyline completed up to quest 537
// ========================================================

function onStart() {
    if (factionRank("Lycan") >= 10) {
        msg("Lycan Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(537)) {
        msg("Prerequisite missing: Quest 537 [Sanguine] is locked. Complete the Lycan storyline in /lycan first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("solo");
    ensureMap("lycan");
}

function onTick() {
    if (factionRank("Lycan") >= 10) {
        msg("Lycan Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("lycan");
    ensureQuest(537);

    if (!hunt("Sanguine", "Sanguine Mask", 1)) return;

    if (isQuestComplete(537)) {
        ensureComplete(537);
    }
}

function onStop() {
    stopCombat();
}
