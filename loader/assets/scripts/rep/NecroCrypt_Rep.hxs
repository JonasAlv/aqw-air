// ========================================================
// Script: Necro Crypt Reputation Farm (.hxs)
// Farms Necro Crypt Reputation to Rank 10
// Quest: 3048 (Help Professor Mueran)
// Prerequisite: Necro Crypt quests unlocked
// ========================================================

function onStart() {
    if (factionRank("Necro Crypt") >= 10) {
        msg("Necro Crypt Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(3048)) {
        msg("Prerequisite missing: Quest 3048 is locked. Complete Necro Crypt intro first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("farm");
    ensureMap("castleundead");
}

function onTick() {
    if (factionRank("Necro Crypt") >= 10) {
        msg("Necro Crypt Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("castleundead");
    ensureQuest(3048);

    if (!hunt("Skeletal Viking", "Old Bone", 25)) return;

    if (isQuestComplete(3048)) {
        ensureComplete(3048);
    }
}

function onStop() {
    stopCombat();
}
