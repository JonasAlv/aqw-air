// ========================================================
// Script: CraggleRock Reputation Farm (.hxs)
// Farms CraggleRock Reputation to Rank 10
// Quest: 7277 (Star of the Sandsea)
// Prerequisite: Wanders / CraggleRock quests unlocked
// ========================================================

function onStart() {
    if (factionRank("CraggleRock") >= 10) {
        msg("CraggleRock Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(7277)) {
        msg("Prerequisite missing: Quest 7277 is locked. Complete the Wanders / CraggleRock intro quests first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("solo");
    ensureMap("wanders");
}

function onTick() {
    if (factionRank("CraggleRock") >= 10) {
        msg("CraggleRock Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("wanders");
    ensureQuest(7277);

    if (!hunt("Kalestev", 1)) return;

    if (isQuestComplete(7277)) {
        ensureComplete(7277);
    }
}

function onStop() {
    stopCombat();
}
