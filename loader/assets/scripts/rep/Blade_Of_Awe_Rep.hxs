// ========================================================
// Script: Blade of Awe Reputation Farm (.hxs)
// Farms Blade of Awe Reputation to Rank 10
// Quest: 2935 (Lucion's Post-War Plans)
// Prerequisite: Blade of Awe unlocked (Valencia in /museum)
// ========================================================

function onStart() {
    if (factionRank("Blade of Awe") >= 10) {
        msg("Blade of Awe Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(2935)) {
        msg("Prerequisite missing: Quest 2935 is locked. Unlock Blade of Awe quests at Valencia in /museum first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("farm");
    ensureMap("castleundead", "Enter", "Left");
    autoQuest([2935]);
}

function onTick() {
    if (factionRank("Blade of Awe") >= 10) {
        msg("Blade of Awe Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("castleundead", "Enter", "Left");
    ensureCombat();
}

function onStop() {
    stopAutoQuest();
    stopCombat();
}
