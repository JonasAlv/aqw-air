// ========================================================
// Script: Monster Hunter Reputation Farm (.hxs)
// Farms Monster Hunter Reputation to Rank 10
// Quests: 5849, 5850
// Prerequisite: Monster Hunter intro in /pilgrimage completed
// ========================================================

function onStart() {
    if (factionRank("Monster Hunter") >= 10) {
        msg("Monster Hunter Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(5849)) {
        msg("Prerequisite missing: Quest 5849 is locked. Complete Monster Hunter intro in /pilgrimage first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("farm");
    ensureMap("pilgrimage", "r5", "Left");
}

function onTick() {
    if (factionRank("Monster Hunter") >= 10) {
        msg("Monster Hunter Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("pilgrimage", "r5", "Left");
    ensureQuest(5849);
    ensureQuest(5850);

    if (!hunt("SpiderWing", "Spiderwing Captured", 4)) return;
    if (!hunt("Urstrix", "Urstrix Captured", 4)) return;
    if (!hunt("Ravenous Parasite", "Ravenous Parasites Slain", 7)) return;

    if (isQuestComplete(5849)) ensureComplete(5849);
    if (isQuestComplete(5850)) ensureComplete(5850);
}

function onStop() {
    stopCombat();
}
