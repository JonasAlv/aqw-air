// ========================================================
// Script: EtherStorm Reputation Farm (.hxs)
// Farms EtherStorm Reputation to Rank 10
// Quest: 3494 (Dapper Hats)
// Prerequisite: EtherStorm quests unlocked
// ========================================================

function onStart() {
    if (factionRank("EtherStorm") >= 10) {
        msg("EtherStorm Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(3494)) {
        msg("Prerequisite missing: Quest 3494 is locked. Complete EtherStorm storyline first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("farm");
    ensureMap("waterstorm", "r5", "Left");
    autoQuest([3494]);
}

function onTick() {
    if (factionRank("EtherStorm") >= 10) {
        msg("EtherStorm Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("waterstorm", "r5", "Left");
    ensureCombat();
}

function onStop() {
    stopAutoQuest();
    stopCombat();
}
