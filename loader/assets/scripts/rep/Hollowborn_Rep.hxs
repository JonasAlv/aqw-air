// ========================================================
// Script: Hollowborn Reputation Farm (.hxs)
// Farms Hollowborn Reputation to Rank 10
// Quests: 7553 (Get the Seeds), 7555 (Flex it!)
// Prerequisite: Hollowborn quests unlocked at Lae in /shadowrealm
// ========================================================

function onStart() {
    if (factionRank("Hollowborn") >= 10) {
        msg("Hollowborn Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(7553)) {
        msg("Prerequisite missing: Quest 7553 is locked. Complete Hollowborn intro quests at Lae in /shadowrealm first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("farm");
    ensureMap("shadowrealm", "r2", "Left");
}

function onTick() {
    if (factionRank("Hollowborn") >= 10) {
        msg("Hollowborn Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("shadowrealm", "r2", "Left");
    ensureQuest(7553);
    ensureQuest(7555);

    if (!hunt("Gargrowl", "Darkseed", 8)) return;
    if (!hunt("Shadow Guardian", "Shadow Medallion", 5)) return;

    if (isQuestComplete(7553)) ensureComplete(7553);
    if (isQuestComplete(7555)) ensureComplete(7555);
}

function onStop() {
    stopCombat();
}
