// ========================================================
// Script: Pet Tamer Reputation Farm (.hxs)
// Farms Pet Tamer Reputation to Rank 10
// Quest: 5261
// Prerequisite: Pet Tamer intro in /greenguardwest completed
// ========================================================

function onStart() {
    if (factionRank("Pet Tamer") >= 10) {
        msg("Pet Tamer Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(5261)) {
        msg("Prerequisite missing: Quest 5261 is locked. Complete Pet Tamer intro in /greenguardwest first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("farm");
    ensureMap("greenguardwest", "West7", "Down");
    autoQuest([5261]);
}

function onTick() {
    if (factionRank("Pet Tamer") >= 10) {
        msg("Pet Tamer Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("greenguardwest", "West7", "Down");
    if (!hunt("Mogzard", "Mogzard Captured", 1)) return;
}

function onStop() {
    stopAutoQuest();
    stopCombat();
}
