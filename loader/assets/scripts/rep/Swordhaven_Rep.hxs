// ========================================================
// Script: Swordhaven Reputation Farm (.hxs)
// Farms Swordhaven Reputation to Rank 10
// Quests: 3065, 3066, 3067, 3070, 3085, 3086, 3087
// Prerequisite: Swordhaven Castle intro quests completed
// ========================================================

function onStart() {
    if (factionRank("Swordhaven") >= 10) {
        msg("Swordhaven Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(3065)) {
        msg("Prerequisite missing: Quest 3065 is locked. Complete Swordhaven Castle intro quests first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("farm");
    ensureMap("castle");
    autoQuest([3065, 3066, 3067, 3070, 3085, 3086, 3087]);
}

function onTick() {
    if (factionRank("Swordhaven") >= 10) {
        msg("Swordhaven Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("castle");

    if (!hunt("Castle Spider", 5)) return;
    if (!hunt("Castle Wraith", 5)) return;
    if (!hunt("Gargoyle", 5)) return;
    if (!hunt("Dungeon Fiend", 5)) return;
}

function onStop() {
    stopAutoQuest();
    stopCombat();
}
