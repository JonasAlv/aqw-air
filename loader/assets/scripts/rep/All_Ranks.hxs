        case "Mythsong":
            if (!isQuestUnlocked(4829)) {
                msg("Skipping Mythsong: Quest 4829 locked.");
                nextFaction();
                return;
            }
            ensureMap("beehive");
            ensureQuest(4829);
            if (!hunt("Stinger", "Honey Gathered", 10)) return;
            if (isQuestComplete(4829)) ensureComplete(4829);

        case "Sandsea":
            if (!isQuestUnlocked(916)) {
                msg("Skipping Sandsea: Quest 916 locked.");
                nextFaction();
                return;
            }
            ensureMap("sandsea", "Enter", "Spawn");
            ensureQuest(916);
            ensureQuest(917);
            ensureCombat();
            if (isQuestComplete(916)) ensureComplete(916);
            if (isQuestComplete(917)) ensureComplete(917);

        case "Swordhaven":
            if (!isQuestUnlocked(3065)) {
                msg("Skipping Swordhaven: Quest 3065 locked.");
                nextFaction();
                return;
            }
            ensureMap("castle");
            ensureQuest(3065);
            ensureQuest(3066);
            if (!hunt("Castle Spider", 5)) return;
            if (!hunt("Castle Wraith", 5)) return;
            if (isQuestComplete(3065)) ensureComplete(3065);
            if (isQuestComplete(3066)) ensureComplete(3066);

        case "ThunderForge":
            if (!isQuestUnlocked(2733)) {
                msg("Skipping ThunderForge: Quest 2733 locked.");
                nextFaction();
                return;
            }
            equipLoadout("solo");
            ensureMap("deathpits");
            ensureQuest(2733);
            if (!hunt("Wrathful Vestis", "Vestis's Chaos Eye", 1)) return;
            if (isQuestComplete(2733)) ensureComplete(2733);

        case "Yokai":
            if (!isQuestUnlocked(383)) {
                msg("Skipping Yokai: Quest 383 locked.");
                nextFaction();
                return;
            }
            ensureMap("dragonkoiz");
            ensureQuest(383);
            if (!hunt("Pockey Chew", "Piece of Pockey", 3)) return;
            if (isQuestComplete(383)) ensureComplete(383);

        case "Eternal":
            if (!isQuestUnlocked(5198)) {
                msg("Skipping Eternal: Quest 5198 locked.");
                nextFaction();
                return;
            }
            ensureMap("fourdpyramid");
            ensureQuest(5198);
            if (!hunt("White Sphynx", "White Gem", 2)) return;
            if (!hunt("Black Sphynx", "Black Gem", 2)) return;
            if (isQuestComplete(5198)) ensureComplete(5198);

        case "Death Pit Arena":
            if (!isQuestUnlocked(5153)) {
                msg("Skipping Death Pit Arena: Quest 5153 locked.");
                nextFaction();
                return;
            }
            equipLoadout("solo");
            ensureMap("deathpit");
            ensureQuest(5153);
            if (!hunt("General Hun'Gar", "General Hun'Gar Defeated", 1)) return;
            if (isQuestComplete(5153)) ensureComplete(5153);

        case "Diabolical":
            if (!isQuestUnlocked(7877)) {
                msg("Skipping Diabolical: Quest 7877 locked.");
                nextFaction();
                return;
            }
            equipLoadout("solo");
            ensureMap("mudluk");
            ensureQuest(7877);
            if (!hunt("Tiger Leech", "Swamped Leech Tooth", 1)) return;
            if (isQuestComplete(7877)) ensureComplete(7877);

        case "CraggleRock":
            if (!isQuestUnlocked(7277)) {
                msg("Skipping CraggleRock: Quest 7277 locked.");
                nextFaction();
                return;
            }
            equipLoadout("solo");
            ensureMap("wanders");
            ensureQuest(7277);
            if (!hunt("Kalestev", 1)) return;
            if (isQuestComplete(7277)) ensureComplete(7277);

        case "Northpointe":
            if (!isQuestUnlocked(4027)) {
                msg("Skipping Northpointe: Quest 4027 locked.");
                nextFaction();
                return;
            }
            ensureMap("northpointe");
            ensureQuest(4027);
            if (!hunt("Grim Stalker", "Bunch of Sage", 10)) return;
            if (isQuestComplete(4027)) ensureComplete(4027);

        case "Ravenloss":
            if (!isQuestUnlocked(3445)) {
                msg("Skipping Ravenloss: Quest 3445 locked.");
                nextFaction();
                return;
            }
            ensureMap("twilightedge");
            ensureQuest(3445);
            if (!hunt("ChaosWeaver Mage", "ChaosWeaver Slain", 10)) return;
            if (isQuestComplete(3445)) ensureComplete(3445);

        case "Dwarfhold":
            if (!isQuestUnlocked(320)) {
                msg("Skipping Dwarfhold: Quest 320 locked.");
                nextFaction();
                return;
            }
            ensureMap("pines", "Enter", "Right");
            ensureQuest(320);
            ensureQuest(321);
            if (!hunt("Pine Grizzly", "Bear Skin", 5)) return;
            if (!hunt("Red Shell Turtle", "Red Turtle Shell", 5)) return;
            if (isQuestComplete(320)) ensureComplete(320);
            if (isQuestComplete(321)) ensureComplete(321);

        case "Druid Grove":
            if (!isQuestUnlocked(3049)) {
                msg("Skipping Druid Grove: Quest 3049 locked.");
                nextFaction();
                return;
            }
            ensureMap("bloodtusk");
            ensureQuest(3049);
            if (!hunt("Crystal-Rock", 5)) return;
            if (isQuestComplete(3049)) ensureComplete(3049);

        case "Aegis":
            if (!isQuestUnlocked(4900)) {
                msg("Skipping Aegis: Quest 4900 locked.");
                nextFaction();
                return;
            }
            ensureMap("skytower");
            ensureQuest(4900);
            if (!hunt("Seraphic Assassin", 5)) return;
            if (!hunt("Virtuous Warrior", 5)) return;
            if (isQuestComplete(4900)) ensureComplete(4900);

        case "Chaos Militia":
            if (!isQuestUnlocked(5775)) {
                msg("Skipping Chaos Militia: Quest 5775 locked.");
                nextFaction();
                return;
            }
            ensureMap("citadel");
            ensureQuest(5775);
            if (!hunt("Inquisitor Guard", 5)) return;
            if (isQuestComplete(5775)) ensureComplete(5775);

        case "Infernal Army":
            if (!isQuestUnlocked(5707)) {
                msg("Skipping Infernal Army: Quest 5707 locked.");
                nextFaction();
                return;
            }
            ensureMap("dreadfire", "r10", "Left");
            ensureQuest(5707);
            if (!hunt("Living Brimstone", "Living Brimstone Defeated", 1)) return;
            if (isQuestComplete(5707)) ensureComplete(5707);

        case "Monster Hunter":
            if (!isQuestUnlocked(5849)) {
                msg("Skipping Monster Hunter: Quest 5849 locked.");
                nextFaction();
                return;
            }
            ensureMap("pilgrimage", "r5", "Left");
            ensureQuest(5849);
            if (!hunt("SpiderWing", "Spiderwing Captured", 4)) return;
            if (isQuestComplete(5849)) ensureComplete(5849);

        case "Somnia":
            if (!isQuestUnlocked(7665)) {
                msg("Skipping Somnia: Quest 7665 locked.");
                nextFaction();
                return;
            }
            ensureMap("somnia");
            ensureQuest(7665);
            if (!hunt("Nightspore", "Dream Truffle", 8)) return;
            if (isQuestComplete(7665)) ensureComplete(7665);

        case "TreasureHunter":
            if (!isQuestUnlocked(6593)) {
                msg("Skipping Treasure Hunter: Quest 6593 locked.");
                nextFaction();
                return;
            }
            ensureMap("stalagbite");
            ensureQuest(6593);
            if (!hunt("Balboa", "Super Specific Rock", 1)) return;
            if (isQuestComplete(6593)) ensureComplete(6593);

        case "Necro Crypt":
            if (!isQuestUnlocked(3048)) {
                msg("Skipping Necro Crypt: Quest 3048 locked.");
                nextFaction();
                return;
            }
            ensureMap("castleundead");
            ensureQuest(3048);
            if (!hunt("Skeletal Viking", "Old Bone", 25)) return;
