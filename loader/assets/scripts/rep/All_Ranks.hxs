// ========================================================
// Script: Master All Reputations Farm (.hxs)
// Sequentially checks and farms all factions to Rank 10.
// Checks prerequisites upfront: if locked, notifies and skips
// cleanly to the next faction without breaking.
// ========================================================

var step = 0;
var factionList = [
    "Arcangrove",
    "Blade of Awe",
    "Brightoak",
    "Chaos",
    "ChronoSpan",
    "DoomWood",
    "Dreadrock",
    "Embersea",
    "EtherStorm",
    "Evil",
    "Good",
    "Glacera",
    "Hollowborn",
    "Horc",
    "Troll",
    "Lycan",
    "Vampire",
    "Mythsong",
    "Sandsea",
    "Swordhaven",
    "ThunderForge",
    "Yokai",
    "Eternal",
    "Death Pit Arena",
    "Diabolical",
    "CraggleRock",
    "Northpointe",
    "Ravenloss",
    "Dwarfhold",
    "Druid Grove",
    "Aegis",
    "Chaos Militia",
    "Infernal Army",
    "Monster Hunter",
    "Somnia",
    "TreasureHunter",
    "Necro Crypt",
    "Pet Tamer",
    "Skye",
    "Dreadfire"
];

function onStart() {
    acceptAllDrops();
    equipLoadout("farm");
    step = 0;
    msg("Starting Master All Ranks farm.");
}

function nextFaction() {
    stopAutoQuest();
    stopCombat();
    step++;
}

function onTick() {
    if (step >= factionList.length) {
        msg("All reputations processed! Farm complete.");
        stop();
        return;
    }

    var current = factionList[step];

    // Check if already Rank 10
    if (factionRank(current) >= 10) {
        nextFaction();
        return;
    }

    // Process current faction with prerequisite verification
    switch (current) {
        case "Arcangrove":
            ensureMap("arcangrove");
            ensureQuest(794);
            ensureQuest(795);
            if (!hunt("Gorillaphant", 5)) return;
            if (!hunt("Seed Spitter", 5)) return;
            if (isQuestComplete(794)) ensureComplete(794);
            if (isQuestComplete(795)) ensureComplete(795);

        case "Blade of Awe":
            if (!isQuestUnlocked(2935)) {
                msg("Skipping Blade of Awe: Quest 2935 locked.");
                nextFaction();
                return;
            }
            ensureMap("castleundead", "Enter", "Left");
            ensureQuest(2935);
            ensureCombat();
            if (isQuestComplete(2935)) ensureComplete(2935);

        case "Brightoak":
            if (!isQuestUnlocked(4667)) {
                msg("Skipping Brightoak: Quest 4667 locked.");
                nextFaction();
                return;
            }
            ensureMap("elfhame");
            ensureQuest(4667);
            getMapItem(3984);
            if (isQuestComplete(4667)) ensureComplete(4667);

        case "Chaos":
            if (!isQuestUnlocked(3594)) {
                msg("Skipping Chaos: Quest 3594 locked.");
                nextFaction();
                return;
            }
            ensureMap("mountdoomskull", "b1", "Left");
            ensureQuest(3594);
            ensureCombat();
            if (isQuestComplete(3594)) ensureComplete(3594);

        case "ChronoSpan":
            if (!isQuestUnlocked(2204)) {
                msg("Skipping ChronoSpan: Quest 2204 locked.");
                nextFaction();
                return;
            }
            ensureMap("thespan");
            ensureQuest(2204);
            ensureCell("r6", "Left");
            if (!hunt("Moglin Ghost", "Tin of Ghost Dust", 2)) return;
            ensureCell("r4", "Left");
            if (!hunt("Minx Fairy", "8 oz Fairy Glitter", 3)) return;
            if (!hunt("Tog", "Tog Fang", 4)) return;
            if (isQuestComplete(2204)) ensureComplete(2204);

        case "DoomWood":
            if (!isQuestUnlocked(1151)) {
                msg("Skipping DoomWood: Quest 1151 locked.");
                nextFaction();
                return;
            }
            ensureMap("shadowfallwar", "Garden1", "Left");
            ensureQuest(1151);
            ensureQuest(1152);
            ensureCombat();
            if (isQuestComplete(1151)) ensureComplete(1151);
            if (isQuestComplete(1152)) ensureComplete(1152);

        case "Dreadrock":
            if (!isQuestUnlocked(4862)) {
                msg("Skipping Dreadrock: Quest 4862 locked.");
                nextFaction();
                return;
            }
            ensureMap("dreadrock", "r3", "Bottom");
            ensureQuest(4862);
            ensureQuest(4863);
            ensureCombat();
            if (isQuestComplete(4862)) ensureComplete(4862);
            if (isQuestComplete(4863)) ensureComplete(4863);

        case "Embersea":
            if (!isQuestUnlocked(4228) && !isQuestUnlocked(4080)) {
                msg("Skipping Embersea: Quests locked.");
                nextFaction();
                return;
            }
            ensureMap("fireforge");
            ensureQuest(4228);
            if (!hunt("Blazebinder", 5)) return;
            if (isQuestComplete(4228)) ensureComplete(4228);

        case "EtherStorm":
            if (!isQuestUnlocked(3494)) {
                msg("Skipping EtherStorm: Quest 3494 locked.");
                nextFaction();
                return;
            }
            ensureMap("waterstorm", "r5", "Left");
            ensureQuest(3494);
            ensureCombat();
            if (isQuestComplete(3494)) ensureComplete(3494);

        case "Evil":
            if (factionRank("Evil") < 4) {
                ensureMap("swordhavenbridge");
                ensureQuest(364);
                if (!hunt("Slime", "Youthanize", 1)) return;
                ensureComplete(364);
            } else {
                ensureMap("castleundead", "Enter", "Left");
                ensureQuest(367);
                ensureCombat();
                if (isQuestComplete(367)) ensureComplete(367);
            }

        case "Good":
            if (isQuestUnlocked(1952)) {
                ensureMap("poisonforest");
                ensureQuest(1952);
                if (!hunt("Burning Loyalist", 5)) return;
                if (isQuestComplete(1952)) ensureComplete(1952);
            } else if (factionRank("Good") < 4) {
                ensureMap("swordhavenbridge", "Bridge", "Left");
                ensureQuest(369);
                ensureCombat();
                if (isQuestComplete(369)) ensureComplete(369);
            } else {
                ensureMap("castleundead", "Enter", "Spawn");
                ensureQuest(372);
                ensureCombat();
                if (isQuestComplete(372)) ensureComplete(372);
            }

        case "Glacera":
            if (!isQuestUnlocked(5597)) {
                msg("Skipping Glacera: Quest 5597 locked.");
                nextFaction();
                return;
            }
            ensureMap("icewindwar", "r5", "Left");
            ensureQuest(5597);
            ensureQuest(5598);
            ensureCombat();
            if (isQuestComplete(5597)) ensureComplete(5597);
            if (isQuestComplete(5598)) ensureComplete(5598);

        case "Hollowborn":
            if (!isQuestUnlocked(7553)) {
                msg("Skipping Hollowborn: Quest 7553 locked.");
                nextFaction();
                return;
            }
            ensureMap("shadowrealm", "r2", "Left");
            ensureQuest(7553);
            ensureQuest(7555);
            if (!hunt("Gargrowl", "Darkseed", 8)) return;
            if (!hunt("Shadow Guardian", "Shadow Medallion", 5)) return;
            if (isQuestComplete(7553)) ensureComplete(7553);
            if (isQuestComplete(7555)) ensureComplete(7555);

        case "Horc":
            if (!isQuestUnlocked(1265)) {
                msg("Skipping Horc: Quest 1265 locked.");
                nextFaction();
                return;
            }
            ensureMap("bloodtuskwar");
            ensureQuest(1265);
            if (!hunt("Chaotic Lemurphant", "Chaorrupted Eye", 3)) return;
            if (!hunt("Chaotic Horcboar", "Chaorrupted Tentacle", 5)) return;
            if (!hunt("Chaotic Chinchilizard", "Chaorrupted Tusk", 5)) return;
            if (isQuestComplete(1265)) ensureComplete(1265);

        case "Troll":
            if (!isQuestUnlocked(1263)) {
                msg("Skipping Troll: Quest 1263 locked.");
                nextFaction();
                return;
            }
            ensureMap("bloodtuskwar");
            ensureQuest(1263);
            if (!hunt("Chaotic Lemurphant", "Chaorrupted Eye", 3)) return;
            if (!hunt("Chaotic Horcboar", "Chaorrupted Tentacle", 5)) return;
            if (!hunt("Chaotic Chinchilizard", "Chaorrupted Tusk", 5)) return;
            if (isQuestComplete(1263)) ensureComplete(1263);

        case "Lycan":
            if (!isQuestUnlocked(537)) {
                msg("Skipping Lycan: Quest 537 locked.");
                nextFaction();
                return;
            }
            equipLoadout("solo");
            ensureMap("lycan");
            ensureQuest(537);
            if (!hunt("Sanguine", "Sanguine Mask", 1)) return;
            if (isQuestComplete(537)) ensureComplete(537);

        case "Vampire":
            if (!isQuestUnlocked(522)) {
