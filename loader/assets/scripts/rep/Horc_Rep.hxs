// ========================================================
// Script: Horc Reputation Farm (.hxs)
// Farms Horc Reputation to Rank 10
// Quest: 1265 (Bloodtusk War)
// Prerequisite: Bloodtusk War quests unlocked
// ========================================================

function onStart() {
    if (factionRank("Horc") >= 10) {
        msg("Horc Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(1265)) {
        msg("Prerequisite missing: Quest 1265 is locked. Complete Bloodtusk War storyline first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("farm");
    ensureMap("bloodtuskwar");
}

function onTick() {
    if (factionRank("Horc") >= 10) {
        msg("Horc Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("bloodtuskwar");
    ensureQuest(1265);

    if (!hunt("Chaotic Lemurphant", "Chaorrupted Eye", 3)) return;
    if (!hunt("Chaotic Horcboar", "Chaorrupted Tentacle", 5)) return;
    if (!hunt("Chaotic Chinchilizard", "Chaorrupted Tusk", 5)) return;

    if (isQuestComplete(1265)) {
        ensureComplete(1265);
    }
}

function onStop() {
    stopCombat();
}
