// ========================================================
// Script: Troll Reputation Farm (.hxs)
// Farms Troll Reputation to Rank 10
// Quest: 1263 (Bloodtusk War)
// Prerequisite: Bloodtusk War quests unlocked
// ========================================================

function onStart() {
    if (factionRank("Troll") >= 10) {
        msg("Troll Reputation is already Rank 10.");
        stop();
        return;
    }

    if (!isQuestUnlocked(1263)) {
        msg("Prerequisite missing: Quest 1263 is locked. Complete Bloodtusk War storyline first.");
        stop();
        return;
    }

    acceptAllDrops();
    equipLoadout("farm");
    ensureMap("bloodtuskwar");
}

function onTick() {
    if (factionRank("Troll") >= 10) {
        msg("Troll Reputation reached Rank 10! Farm complete.");
        stop();
        return;
    }

    ensureMap("bloodtuskwar");
    ensureQuest(1263);

    if (!hunt("Chaotic Lemurphant", "Chaorrupted Eye", 3)) return;
    if (!hunt("Chaotic Horcboar", "Chaorrupted Tentacle", 5)) return;
    if (!hunt("Chaotic Chinchilizard", "Chaorrupted Tusk", 5)) return;

    if (isQuestComplete(1263)) {
        ensureComplete(1263);
    }
}

function onStop() {
    stopCombat();
}
