// ========================================================
// Script: 00_Complete_13_LOC.hxs
// Master Runner: 13 Lords of Chaos Saga (Full Complete)
// Seamlessly checks each chapter and resumes from where you left off!
// Final Saga Quest: 3881 (The Final Showdown!)
// ========================================================

var MILESTONES = [3881, 6219, 272, 363, 488, 597, 710, 847, 1005, 1473, 2519, 2814, 3189, 3160];
var checkedProgress = false;

function onStart() {
    checkedProgress = false;
    acceptAllDrops();
    setSkipCutscenes(true);
    equipLoadout("farm");
    log("Starting 13 Lords of Chaos Saga auto-progression...");
}

function onTick() {
    if (!checkedProgress) {
        if (!isHouse()) {
            ensureMap("house");
            return;
        }
        if (!ensureQuestsLoaded(MILESTONES)) {
            return;
        }
        checkedProgress = true;
        log("Saga milestone progress verified at house. Resuming story...");
    }

    if (isCompletedBefore(3881)) {
        log("13 Lords of Chaos Saga 100% completed! Drakath and all 13 Chaos Lords defeated!");
        stop();
        return;
    }

    // ====================================================
    // 01. Prologue (Final: 6219)
    // ====================================================
    if (!isCompletedBefore(6219)) {
        if (!storyKillQuest(183, "battleundera", "Skeletal Fire Mage")) return;
