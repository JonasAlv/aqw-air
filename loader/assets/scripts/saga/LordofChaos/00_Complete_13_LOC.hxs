            if (!ensureMap("prison")) return;
            ensureQuest(6216);
            getMapItem(39);
            if (!hasItem("42993") && !hasItem("Key to the Crypt")) buyItem(1559, "42993");
            if (canComplete(6216)) ensureComplete(6216);
            return;
        }
        if (!storyMapItemQuest(6217, "chaoscrypt", 5662)) return;
        if (!storyKillQuest(6218, "chaoscrypt", "Chaorrupted Knight")) return;
        if (!storyKillQuest(6219, "forestchaos", ["Chaorrupted Bear", "Chaorrupted Wolf"])) return;
        return;
    }

