// ========================================================
// Script: 09_Khasaanda_Horc.hxs
// 13 Lords of Chaos Saga: 8th Lord - Khasaanda (Horc Storyline)
// Final Quest: 1473 (Choose: Khasaanda Confrontation?)
// ========================================================

function onStart() {
    if (isCompletedBefore(1473)) {
        log("Khasaanda (Horc) chapter is already completed.");
        stop();
        return;
    }
    acceptAllDrops();
    setSkipCutscenes(true);
    equipLoadout("farm");
}

function onTick() {
    if (isCompletedBefore(1473)) {
        log("Khasaanda (Horc) chapter completed!");
        stop();
        return;
    }

    // 1232: Troll Stink!
    if (!storyMapItemQuest(1232, "bloodtusk", 523)) return;
    if (!storyKillQuest(1232, "crossroads", ["Chinchilizard", "Trollola Plant"])) return;

    // 1233: It Not Time Yet
    if (!storyKillQuest(1233, "crossroads", ["Lemurphant", "Koalion"])) return;

    // 1234: Mountain Protection
    if (!storyMapItemQuest(1234, "crossroads", 525)) return;
    if (!storyKillQuest(1234, "crossroads", ["Lemurphant", "Chinchilizard"])) return;

    // 1235: Clear Mind, Cleanse Spirit
    if (!storyMapItemQuest(1235, "crossroads", 521, 10)) return;
    if (!storyKillQuest(1235, "crossroads", ["Trollola Plant", "Lemurphant", "Koalion"])) return;

    // 1236: She Who Asks
    if (!isCompletedBefore(1236)) {
        storyChainQuest(1236);
        return;
    }

    // 1237: Be Horc Inside
    if (!storyMapItemQuest(1237, "crossroads", [524, 522], 5)) return;
    if (!storyKillQuest(1237, "crossroads", ["Rock", "Koalion", "Lemurphant"])) return;

    // 1241: She Who Answers 2
    if (!isCompletedBefore(1241)) {
        storyChainQuest(1241);
        return;
    }

    // 1273: Chaos Enrages the Horcs
    if (!isCompletedBefore(1273)) {
        storyChainQuest(1273);
        return;
    }

    // 1280: Into, Under the Mountain
    if (!storyMapItemQuest(1280, "ravinetemple", 553)) return;

    // 1281: Has the Land Been Tainted?
    if (!storyMapItemQuest(1281, "ravinetemple", 554, 5)) return;
    if (!storyMapItemQuest(1281, "ravinetemple", [555, 556], 10)) return;

    // 1282: Tears of the Mountain
    if (!storyKillQuest(1282, "ravinetemple", "Temple Guardian")) return;

    // 1283: Defend the UnderMountain
    if (!storyMapItemQuest(1283, "ravinetemple", 557, 10)) return;
    if (!storyKillQuest(1283, "ravinetemple", "Temple Guardian")) return;

    // 1284: Alliance Defiance
    if (!storyKillQuest(1284, "ravinetemple", "Temple Guardian")) return;

    // 1375: Scout and Return
    if (!storyMapItemQuest(1375, "alliance", [679, 680])) return;

    // 1376: Good and Evil Not Always Right
    if (!storyKillQuest(1376, "alliance", ["Good Soldier", "Evil Soldier"])) return;

    // 1377: Trapping Savage Soldiers
    if (!storyMapItemQuest(1377, "alliance", 675, 10)) return;

    // 1378: Find What is Hidden Inside
    if (!storyMapItemQuest(1378, "alliance", 676)) return;

    // 1379: Chaorruption Rejection
    if (!storyKillQuest(1379, "alliance", "Chaorrupted Evil Soldier")) return;

    // 1380: Alliance Subdued
    if (!storyKillQuest(1380, "alliance", ["General Cynari", "General Tibias"])) return;

    // 1424: Cleanse the Chaorruption
    if (!storyKillQuest(1424, "ancienttemple", "Chaotic Vulture")) return;

    // 1425: Chaorruption Cure?
    if (!storyMapItemQuest(1425, "ancienttemple", 706, 7)) return;
    if (!storyKillQuest(1425, "ancienttemple", "Chaotic Vulture")) return;

    // 1426: Guardian Salvation
    if (!storyKillQuest(1426, "ancienttemple", "Chaos Troll Spirit")) return;

    // 1427: Poison for a Purpose
    if (!storyKillQuest(1427, "ancienttemple", "Serpentress")) return;

    // 1428: The Heart of the Temple Awaits
    if (!storyMapItemQuest(1428, "ancienttemple", 707)) return;

    // 1456: Wounds in Stones and Beasts
    if (!storyMapItemQuest(1456, "orecavern", 717)) return;

    // 1457: Light in Underhome
    if (!storyMapItemQuest(1457, "orecavern", 719, 5)) return;
    if (!storyKillQuest(1457, "orecavern", "Crashroom")) return;

    // 1458: Truth is its Own Light
    if (!storyMapItemQuest(1458, "orecavern", 718, 5)) return;

    // 1459: Horcs Know Mercy
    if (!storyKillQuest(1459, "orecavern", "Chaorrupted Evil Soldier")) return;

    // 1460: Battle the Baas!
    if (!storyKillQuest(1460, "orecavern", "Naga Baas")) return;

    // 1469: Know the Nexus
    if (!storyMapItemQuest(1469, "dreamnexus", [734, 735, 736, 737])) return;

    // 1470: Secure a Route Home
    if (!storyKillQuest(1470, "dreamnexus", ["Dark Wyvern", "Aether Serpent"])) return;

    // 1471: DreamDancers' Orbs
    if (!storyMapItemQuest(1471, "dreamnexus", 738, 10)) return;
    if (!storyMapItemQuest(1471, "dreamnexus", 739, 11)) return;

    // 1472: Master the Flames
    if (!storyKillQuest(1472, "dreamnexus", "Solar Phoenix")) return;

    // 1473: Choose: Khasaanda Confrontation?
    if (!isCompletedBefore(1473)) {
        equipLoadout("solo");
        if (!storyKillQuest(1473, "dreamnexus", "Khasaanda")) return;
    }
}
