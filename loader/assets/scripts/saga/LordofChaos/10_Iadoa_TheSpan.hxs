// ========================================================
// Script: 10_Iadoa_TheSpan.hxs
// 13 Lords of Chaos Saga: 9th Lord - Iadoa (The Span)
// Final Quest: 2519 (Chaos Lord Iadoa)
// ========================================================

var checkedProgress = false;

function onStart() {
    checkedProgress = false;
    if (isCompletedBefore(2519)) {
        log("Iadoa chapter is already completed.");
        stop();
        return;
    }
    acceptAllDrops();
    setSkipCutscenes(true);
    equipLoadout("farm");
}

function onTick() {
    if (isCompletedBefore(2519)) {
        log("Iadoa chapter completed!");
        stop();
        return;
    }

    // 1. Initial house check to safely verify progress without combat aggro
    if (!checkedProgress) {
        if (!isHouse()) {
            ensureHouse();
            return;
        }
        if (!ensureQuestsLoaded([2239, 2240, 2241, 2242, 2243, 2244, 2253, 2254, 2255, 2256, 2257, 2258, 2376, 2377, 2378, 2379, 2380, 2381, 2382, 2383, 2384, 2385, 2386, 2470, 2471, 2472, 2473, 2474, 2475, 2476, 2477, 2478, 2479, 2504, 2505, 2506, 2507, 2508, 2509, 2510, 2511, 2512, 2513, 2515, 2516, 2517, 2518, 2519])) {
            return;
        }
        checkedProgress = true;
        log("Saga milestone progress verified at house. Resuming The Span storyline...");
    }

    // 2239: Time to Learn the Truth
    if (quest(2239, "thespan")) {
        if (!mapItem(1358, 1, "Tek's Notes")) return;
        if (!mapItem(1359, 1, "Warlic's Notes")) return;
        if (!mapItem(1360, 1, "Mince's Notes")) return;
        if (!mapItem(1361, 1, "Orb's Notes")) return;
        if (!mapItem(1362, 1, "Bulbug's Notes")) return;
        if (!mapItem(1363, 1, "Lucretia's Notes")) return;
        complete(2239);
    }

    // 2240: Gain Access to Doors
    if (quest(2240, "timelibrary")) {
        if (!hunt("Sneak", "AQ Dimension Key", 1)) return;
        if (!hunt("Tog", "DF Dimension Key", 1)) return;
        if (!hunt("Shadowscythe", "MQ Dimension Key", 1)) return;
        complete(2240);
    }

    // 2241: Adventures and Quests
    if (quest(2241, "timelibrary")) {
        if (!hunt("Moglin Ghost", "Necromancy in AQ Knowledge", 1)) return;
        if (!hunt("Undead Knight", "Tales of Planet-Peril Page", 6)) return;
        if (!mapItem(1365, 3, "Ruby-red Eye Shard")) return;
        complete(2241);
    }

    // 2242: A Fable of Dragons
    if (quest(2242, "timelibrary")) {
        if (!hunt("Tog", "Elemental Orb Knowledge", 8)) return;
        if (!hunt("Tog", "\"Draconic Prophecy\" Page", 6)) return;
        if (!mapItem(1366, 2, "Bony Claw")) return;
        complete(2242);
    }

    // 2243: Mechas and Quests
    if (quest(2243, "timelibrary")) {
        if (!hunt("Shadowscythe", "Shadowscythe Combat Strategy", 7)) return;
        if (!hunt("Training Globe", "Galactic Hypertron Engines: A Primer", 1)) return;
        if (!mapItem(1367, 1, "Mysterious Mirror")) return;
        complete(2243);
    }

    // 2244: After the Chaos
    if (quest(2244, "timelibrary")) {
        if (!hunt("Queen's Recruit", "The Future is Now", 3)) return;
        if (!hunt("Queen's Recruit", "Past Failures Brought Us Here", 2)) return;
        if (!hunt("Queen's Knight", "Princess Freed... but for what?", 2)) return;
        if (!mapItem(1368, 1, "Chaos Eye")) return;
        complete(2244);
    }

    // 2253: Trust is Not Ephemeral
    if (quest(2253, "timevoid")) {
        if (!hunt("Ephemerite", "Ephemeral Dust", 9)) return;
        complete(2253);
    }

    // 2254: In a Split Exasecond
    if (quest(2254, "timevoid")) {
        if (!hunt("Time-Travel Fairy", "Exaglass", 4)) return;
        if (!hunt("Time-Travel Fairy", "Fairy Plasma", 8)) return;
        if (!mapItem(1438, 12, "Fallen Fairy Wings")) return;
        complete(2254);
    }

    // 2255: Time to Prove Yourself
    if (quest(2255, "timevoid")) {
        if (!mapItem(1439, 12, "Pre-Solar Scales")) return;
        if (!hunt("Ephemerite", "Ephemeral Dust", 4)) return;
        if (!hunt("Time-Travel Fairy", "Fairy Plasma", 4)) return;
        complete(2255);
    }

    // 2256: Fill the Empty Hours
    if (quest(2256, "timevoid")) {
        if (!hunt("Time-Travel Fairy", "Powdered Fairy Wings", 6)) return;
        if (!hunt("Void Phoenix", "Dried Phoenix Tears", 6)) return;
        complete(2256);
    }

    // 2257: Clock of the Long Now
    if (quest(2257, "timevoid")) {
        if (!mapItem(1440, 1, "North Glass Turned")) return;
        if (!mapItem(1441, 1, "South Glass Turned")) return;
        if (!mapItem(1442, 1, "East Glass Turned")) return;
        if (!mapItem(1443, 1, "West Glass Turned")) return;
        complete(2257);
    }

    // 2258: Unending Avatar
    if (quest(2258, "timevoid")) {
        if (!hunt("Unending Avatar", "Avatar Slain", 1)) return;
        complete(2258);
    }

    // 2376: Construct Your Reality
    if (quest(2376, "aqlesson")) {
        if (!mapItem(1467, 1, "Orb Located")) return;
        complete(2376);
    }

    // 2377: Reach the Temple
    if (quest(2377, "aqlesson")) {
        if (!hunt("Ninja", "Obstacle Obliterated", 9)) return;
        complete(2377);
    }

    // 2378: Not All Hope is Lost
    if (quest(2378, "aqlesson")) {
        if (!mapItem(1468, 8, "Elemental Orb Located")) return;
        if (!mapItem(1469, 1, "Tome of Hope Read")) return;
        complete(2378);
    }

    // 2379: Bolster the Elements
    if (quest(2379, "aqlesson")) {
        if (!mapItem(1470, 3, "Light of Hope Acquired")) return;
        if (!mapItem(1471, 3, "Tears of Joy Acquired")) return;
        if (!hunt("Eternite Ore", "TimeSpark Acquired", 3)) return;
        if (!hunt("Water Elemental", "Shadows Acquired", 3)) return;
        complete(2379);
    }

    // 2380: Maintain Elemental Strength
    if (quest(2380, "aqlesson")) {
        if (!mapItem(1473, 3, "Adamantite Acquired")) return;
        if (!mapItem(1472, 3, "Balanced Breeze Acquired")) return;
        if (!hunt("Ice Elemental", "Frigid Liquid Acquired", 3)) return;
        if (!hunt("Fire Elemental", "Heart of Lava Acquired", 3)) return;
        complete(2380);
    }

    // 2381: Rescue the Innocent
    if (quest(2381, "aqlesson")) {
        if (!hunt("Void Dragon", "Void Dragon Slain", 3)) return;
        complete(2381);
    }

    // 2382: Get Fired Up... or Shatter!
    if (quest(2382, "aqlesson")) {
        if (!hunt("Firezard", "Fire Orb Shard Regained", 6)) return;
        complete(2382);
    }

    // 2383: Enemies on Ice
    if (quest(2383, "aqlesson")) {
        if (!hunt("Ice Elemental", "Ice Scythe Acquired!", 1)) return;
        complete(2383);
    }

    // 2384: Tek-nical Forging Skill
    if (quest(2384, "thespan")) {
        if (!mapItem(1474, 1, "Tek Forged the Ice Claymore!")) return;
        complete(2384);
    }

    // 2385: Akriloth Assault
    if (quest(2385, "aqlesson")) {
        if (!hunt("Akriloth", "Akriloth Slain!", 1)) return;
        complete(2385);
    }

    // 2386: Proto-Chaos Beast Battle!
    if (quest(2386, "aqlesson")) {
        if (!hunt("Carnax", "Carnax Slain!", 1)) return;
        complete(2386);
    }

    // 2470: Elemental Orb Awareness
    if (quest(2470, "dflesson")) {
        if (!mapItem(1549, 8, "Elemental Orb")) return;
        complete(2470);
    }

    // 2471: Fight Chaos with Fire!
    if (quest(2471, "dflesson")) {
        if (!hunt("Fire Elemental", "Slain Flame Elemental", 8)) return;
        if (!hunt("Fire Elemental", "Chaos Gemerald", 4)) return;
        complete(2471);
    }

    // 2472: Save Aria
    if (quest(2472, "dflesson")) {
        if (!hunt("Lava Slime", "Slain Slime", 5)) return;
        if (!hunt("Fire Elemental", "Slain Elemental", 6)) return;
        if (!hunt("Fire Elemental", "Blue Clue", 1)) return;
        complete(2472);
    }

    // 2473: Find the Time to Travel
    if (quest(2473, "dflesson")) {
        if (!hunt("Tog", "Life AND the Universe", 4)) return;
        if (!hunt("Agitated Orb", "Everything", 5)) return;
        if (!hunt("Agitated Orb", "Hoopy Frood's Towel", 3)) return;
        complete(2473);
    }

    // 2474: Dragon Egg... or Junk?
    if (quest(2474, "dflesson")) {
        if (!hunt("Vultragon", "Chaorrupted Dragon Egg", 1)) return;
        complete(2474);
    }

    // 2475: Dracolich Fortress Detected
    if (quest(2475, "dflesson")) {
        if (!hunt("Chaos Sp-Eye", "Blinded Sp-Eyes", 5)) return;
        complete(2475);
    }

    // 2476: Bone up on the Boss
    if (quest(2476, "dflesson")) {
        if (!hunt("Chaorrupted Evil Soldier", "Smashed Skeletons", 8)) return;
        complete(2476);
    }

    // 2477: Defend the Town!
    if (quest(2477, "dflesson")) {
        if (!hunt("Lava Golem", "Golem Crushed", 6)) return;
        if (!hunt("Fire Elemental", "Elemental Eliminated", 3)) return;
        complete(2477);
    }

    // 2478: ChickenCows, Bacon, and Battle!
    if (quest(2478, "dflesson")) {
        if (!hunt("Chaotic Horcboar", "Hero Protein", 1)) return;
        if (!hunt("Chaotic Chicken", "Spell Rune", 8)) return;
        complete(2478);
    }

    // 2479: The 2nd Proto-Chaos Beast
    if (quest(2479, "dflesson")) {
        if (!hunt("Fluffy the Dracolich", "Fluffy Finished", 1)) return;
        complete(2479);
    }

    // 2504: Board the Ship to Your Future
    if (quest(2504, "mqlesson")) {
        if (!mapItem(1580, 1, "Rocket on your Back")) return;
        complete(2504);
    }

    // 2505: Heal the Chaos Lord
    if (quest(2505, "mqlesson")) {
        if (!hunt("Asteroid", "Iadoa's Mind Fragments", 3)) return;
        complete(2505);
    }

    // 2506: Shadowscythe Detection Beacons
    if (quest(2506, "mqlesson")) {
        if (!mapItem(1581, 5, "Beacon in Place")) return;
        complete(2506);
    }

    // 2507: Test Potential Traitors
    if (quest(2507, "mqlesson")) {
        if (!hunt("MystRaven Student", "Shadowscythe Emblem", 8)) return;
        complete(2507);
    }

    // 2508: Defeat Training Globes
    if (quest(2508, "mqlesson")) {
        if (!hunt("Training Globe", "Training Globe Defeated", 10)) return;
        complete(2508);
    }

    // 2509: Take Flight into the Future
    if (quest(2509, "mqlesson")) {
        if (!hunt("MystRaven Student", "Worsh's Motto", 1)) return;
        complete(2509);
    }

    // 2510: Secrets of the Universe
    if (quest(2510, "mqlesson")) {
        if (!hunt("Chaos Shadowscythe", "Lecture Pages", 3)) return;
        complete(2510);
    }

    // 2511: Mysterious!
    if (quest(2511, "mqlesson")) {
        if (!hunt("Chaos Shadowscythe", "Truth Glasses", 1)) return;
        if (!hunt("Chaos Shadowscythe", "Darkness Destroyed", 13)) return;
        complete(2511);
    }

    // 2512: The 3rd Proto-Chaos Beast
    if (quest(2512, "mqlesson")) {
        if (!hunt("Dragonoid", "Dragonoid Defeated", 1)) return;
        complete(2512);
    }

    // 2513: Chaos Waits and Watches
    if (quest(2513, "deepchaos")) {
        if (!hunt("Chaotic Merdrac", "Spy Slain", 5)) return;
        complete(2513);
    }

    // 2515: The Lure of Chaosanity
    if (quest(2515, "deepchaos")) {
        if (!hunt("Chaos Angler", "Sanity Lure", 7)) return;
        complete(2515);
    }

    // 2516: Music of Nightmares
    if (quest(2516, "deepchaos")) {
        if (!mapItem(1582, 3, "Nightmare Pipe")) return;
        complete(2516);
    }

    // 2517: Chaos Beast Kathool
    if (quest(2517, "deepchaos")) {
        equipLoadout("solo");
        if (!hunt("Kathool", "Kathool Defeated", 1)) return;
        complete(2517);
        equipLoadout("farm");
    }

    // 2518: Starry, Starry Night
    if (quest(2518, "timespace")) {
        if (!hunt("Astral Ephemerite", "Star Death", 6)) return;
        complete(2518);
    }

    // 2519: Chaos Lord Iadoa
    if (quest(2519, "timespace")) {
        equipLoadout("solo");
        if (!hunt("Chaos Lord Iadoa", "Iadoa Defeated", 1)) return;
        complete(2519);
    }
}
