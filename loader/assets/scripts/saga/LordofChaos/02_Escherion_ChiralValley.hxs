// ========================================================
// Script: 02_Escherion_ChiralValley.hxs
// 13 Lords of Chaos Saga: 1st Lord - Escherion (Chiral Valley)
// Final Quest: 272 (Escherion)
// ========================================================

var checkedProgress = false;

function onStart() {
    checkedProgress = false;
    if (isCompletedBefore(272)) {
        log("Escherion chapter is already completed.");
        stop();
        return;
    }
    acceptAllDrops();
    setSkipCutscenes(true);
    equipLoadout("farm");
}

function onTick() {
    if (isCompletedBefore(272)) {
        log("Escherion chapter completed!");
        stop();
        ensureHouse();
        return;
    }

    // 1. Initial house check to safely verify progress without combat aggro
    if (!checkedProgress) {
        if (!isHouse()) {
            ensureHouse();
            return;
        }
        if (!ensureQuestsLoaded([
            245, 246, 247, 260, 248, 249, 250, 251, 252, 255,
            256, 257, 261, 258, 262, 259, 263, 266, 267, 264,
            265, 268, 269, 270, 271, 272
        ])) {
            return;
        }
        checkedProgress = true;
        log("Saga milestone progress verified at house. Resuming Chiral Valley storyline...");
    }

    // 245: Winged Spies (mobius)
    if (quest(245, "mobius")) {
        if (!hunt("Chaos Sp-Eye", "Eyeball Wings", 5)) return;
        complete(245);
    }

    // 246: Chaos Prisoners (mobius)
    if (quest(246, "mobius")) {
        if (!mapItem(42, "Mobius Survivor", 5)) return;
        complete(246);
    }

    // 247: IMP-possible Task (mobius)
    if (quest(247, "mobius")) {
        if (!hunt("Fire Imp", "Imp Tooth", 5)) return;
        complete(247);
    }

    // 260: You Can't Miss It! (mobius)
    if (quest(260, "mobius")) {
        if (!mapItem(44, "Tower Info", 1)) return;
        complete(260);
    }

    // 248: Far Sighted (mobius)
    if (quest(248, "mobius")) {
        if (!hunt("Cyclops Raider", "Cyclops Contact Lenses", 5)) return;
        complete(248);
    }

    // 249: Slugfest (slugfit)
    if (quest(249, "slugfit")) {
        if (!hunt("Slugfit", "Slugfit Scalp", 1)) return;
        complete(249);
    }

    // 250: Chain Reaction (faerie)
    if (quest(250, "faerie")) {
        if (!hunt("Chainsaw Sneevil", "Sneevil Chainsaw", 6)) return;
        complete(250);
    }

    // 251: Epic Drops (faerie)
    if (quest(251, "faerie")) {
        if (!mapItem(43, "Dew Drop", 7)) return;
        complete(251);
    }

    // 252: Jarring Theft (faerie)
    if (quest(252, "faerie")) {
        if (!hunt("Chainsaw Sneevil", "Healing Jar", 1)) return;
        complete(252);
    }

    // 255: Tree Hugger (faerie)
    if (quest(255, "faerie")) {
        if (!hunt("Cyclops Warlord", "Warlord's Beard", 1)) return;
        complete(255);
    }

    // 256: The Second Piece (faerie)
    if (quest(256, "faerie")) {
        if (!hunt("Aracara", "Runed Relic", 1)) return;
        complete(256);
    }

    // 257: Ruined Ruins (cornelis)
    if (quest(257, "cornelis")) {
        if (!hunt("Gargoyle", "Gargoyle Chips", 8)) return;
        complete(257);
    }

    // 261: Energize! (cornelis)
    if (quest(261, "cornelis")) {
        if (!mapItem(45, "Teleport Info", 1)) return;
        complete(261);
    }

    // 258: Blueish Glow (cornelis)
    if (quest(258, "cornelis")) {
        if (!hunt("Gargoyle", "Blue Gems", 10)) return;
        complete(258);
    }

    // 262: Quickdraw (cornelis)
    if (quest(262, "cornelis")) {
        if (!mapItem(46, "Golem Sketch", 1)) return;
        complete(262);
    }

    // 259: Arm Yourself (cornelis)
    if (quest(259, "cornelis")) {
        if (!hunt("Stone Golem", "Golem Arm", 1)) return;
        complete(259);
    }

    // 263: You've Been Framed (cornelis)
    if (quest(263, "cornelis")) {
        if (!mapItem(47, "History Book", 1)) return;
        complete(263);
    }

    // 266: Some Assembly Required (mobius)
    if (quest(266, "mobius")) {
        if (!mapItem(48, "Puzzle Complete", 1)) return;
        complete(266);
    }

    // 267: Teleporter Report (mobius)
    if (quest(267, "mobius")) {
        if (!mapItem(49, "Teleporter Info", 1)) return;
        complete(267);
    }

    // 264: Disguise! (mobius)
    if (quest(264, "mobius")) {
        if (!hunt("Cyclops Raider", "Cloth Scraps", 8)) return;
        complete(264);
    }

    // 265: To-Go Box (faerie)
    if (quest(265, "faerie")) {
        if (!hunt("Chainsaw Sneevil", "Cardboard Box", 4)) return;
        complete(265);
    }

    // 268: Find the Key! Part 1 (relativity)
    if (quest(268, "relativity")) {
        if (!hunt("Cyclops Raider", "Cyclops Door Key", 1)) return;
        complete(268);
    }

    // 269: Find the Key! Part 2 (relativity)
    if (quest(269, "relativity")) {
        if (!hunt("Fire Imp", "Imp Door Key", 6)) return;
        complete(269);
    }

    // 270: Find the Key! Part 3 (relativity)
    if (quest(270, "relativity")) {
        if (!hunt("Head Gargoyle", "Gargoyle Door Key", 1)) return;
        complete(270);
    }

    // 271: The Lake Hydra (hydra)
    if (quest(271, "hydra")) {
        if (!mapItem(50, "Rune Shard Alepha", 1)) return;
        if (!mapItem(51, "Rune Shard Betalin", 1)) return;
        if (!mapItem(52, "Rune Shard Gamilo", 1)) return;
        complete(271);
    }

    // 272: Escherion (escherion)
    if (quest(272, "escherion")) {
        equipLoadout("solo");
        if (monster.findByName("Staff of Inversion", true) != null) {
            hunt("Staff of Inversion");
            return;
        }
        if (!hunt("Escherion", "Defeated Escherion", 1)) return;
        complete(272);
        equipLoadout("farm");
    }
}
