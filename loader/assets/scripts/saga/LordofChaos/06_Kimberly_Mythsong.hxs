// ========================================================
// Script: 06_Kimberly_Mythsong.hxs
// 13 Lords of Chaos Saga: 5th Lord - Kimberly (Mythsong)
// Final Quest: 710 (Kimberly)
// ========================================================

function onStart() {
    if (isCompletedBefore(710)) {
        log("Kimberly chapter is already completed.");
        stop();
        return;
    }
    acceptAllDrops();
    setSkipCutscenes(true);
    equipLoadout("farm");
}

function onTick() {
    if (isCompletedBefore(710)) {
        log("Kimberly chapter completed!");
        stop();
        return;
    }

    // 648: Stairway to Heaven
    if (!storyKillQuest(648, "stairway", ["Grateful Undead", "Rock Lobster"])) return;

    // 649: Rolling Stones
    if (!storyKillQuest(649, "stairway", "Rock Lobster")) return;

    // 650: Light My Fire
    if (!storyKillQuest(650, "stairway", "Grateful Undead")) return;

    // 651: Knockin' on Haven's Door
    if (!storyKillQuest(651, "stairway", ["Elwood Bruise", "Jake Bruise"])) return;

    // 658: Staying Alive
    if (!storyKillQuest(658, "beehive", "Stinger")) return;

    // 659: Killer Queen
    if (!storyKillQuest(659, "beehive", "Killer Queen Bee")) return;

    // 660: Satisfaction
    if (!storyKillQuest(660, "beehive", "*")) return;

    // 661: Dance with Great Godfather of Souls
    if (!isCompletedBefore(661)) {
        storyChainQuest(661, "beehive");
        return;
    }

    // 675: Bad Moon Rising
    if (!storyKillQuest(675, "orchestra", "Mozard")) return;

    // 676: Burning Down The House
    if (!storyKillQuest(676, "orchestra", "Pachelbel's Cannon ")) return;

    // 677: Superstition
    if (!storyKillQuest(677, "orchestra", "Mozard")) return;

    // 678: Soul Man
    if (!storyKillQuest(678, "orchestra", "Faust")) return;

    // 4827: Great gig in the Sky
    if (!storyKillQuest(4827, "stairway", ["Rock Lobster", "Grateful Undead"])) return;

    // 707: Mythsong War Cutscene
    if (!isCompletedBefore(707)) {
        storyChainQuest(707);
        return;
    }

    // 709: Pony Gary Yellow
    if (!storyKillQuest(709, "palooza", "Pony Gary Yellow")) return;

    // 710: Kimberly
    if (!isCompletedBefore(710)) {
        equipLoadout("solo");
        if (!storyKillQuest(710, "palooza", "Kimberly")) return;
    }
}
