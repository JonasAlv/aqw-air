// ========================================================
// Script: 03_Vath_Dwarfhold.hxs
// 13 Lords of Chaos Saga: 2nd Lord - Vath (Dwarfhold)
// Final Quest: 363 (Facing Vath)
// ========================================================

function onStart() {
    if (isCompletedBefore(363)) {
        log("Vath chapter is already completed.");
        stop();
        return;
    }
    acceptAllDrops();
    setSkipCutscenes(true);
    equipLoadout("farm");
}

function onTick() {
    if (isCompletedBefore(363)) {
        log("Vath chapter completed!");
        stop();
        return;
    }

    // 319: Adorable Sisters
    if (!storyMapItemQuest(319, "tavern", 56, 7)) return;

    // 320: Warm and Furry
    if (!storyKillQuest(320, "pines", "Pine Grizzly")) return;

    // 321: Shell Rock
    if (!storyKillQuest(321, "pines", "Red Shell Turtle")) return;

    // 322: Bear Facts
    if (!storyKillQuest(322, "pines", "Twistedtooth")) return;

    // 324: The Spittoon Saloon
    if (!storyKillQuest(324, "pines", "Red Shell Turtle")) return;

    // 325: Bear it all!
    if (!storyKillQuest(325, "pines", "Pine Grizzly")) return;

    // 326: Leather Feathers
    if (!storyKillQuest(326, "pines", "LeatherWing")) return;

    // 327: Follow your Nose!
    if (!storyKillQuest(327, "pines", "Pine Troll")) return;

    // 323: Give Snowbeard His Gold
    if (!isCompletedBefore(323)) {
        storyChainQuest(323);
        return;
    }

    // 344: Bad Memory
    if (!storyMapItemQuest(344, "dwarfhold", 60)) return;

    // 331: Squeeze Water from Stone
    if (!storyKillQuest(331, "mountainpath", "Ore Balboa")) return;

    // 332: Carrion Carrying On
    if (!storyKillQuest(332, "mountainpath", "Vultragon")) return;

    // 333: Bagged Lunch
    if (!storyKillQuest(333, "dwarfhold", "Chaos Drow")) return;

    // 334: Radiant Lamps
    if (!storyKillQuest(334, "dwarfhold", "Glow Worm")) return;

    // 335: Having a Blast
    if (!storyKillQuest(335, "dwarfhold", "Albino Bat")) return;

    // 336: Secret Weapons
    if (!storyKillQuest(336, "dwarfhold", "Chaotic Draconian")) return;

    // 337: Rock Star
    if (!storyMapItemQuest(337, "dwarfhold", 59, 7)) return;

    // 338: All that Glitters
    if (!storyKillQuest(338, "dwarfhold", "Chaos Drow")) return;

    // 339: Gemeralds
    if (!storyKillQuest(339, "dwarfhold", "Chaotic Draconian")) return;

    // 340: Talc to Me
    if (!storyKillQuest(340, "dwarfhold", "Albino Bat")) return;

    // 343: Upper City Gates
    if (!isCompletedBefore(343)) {
        storyChainQuest(343);
        return;
    }

    // 341: Rock me Amadeus
    if (!storyKillQuest(341, "dwarfhold", "Amadeus")) return;

    // 346: Disapoofed
    if (!storyMapItemQuest(346, "uppercity", 61)) return;

    // 347: Hoodwinked
    if (!storyKillQuest(347, "uppercity", "Drow Assassin")) return;

    // 348: Claws for the Cause
    if (!storyKillQuest(348, "uppercity", "Chaotic Draconian")) return;

    // 349: Scrambled Eggs
    if (!storyKillQuest(349, "uppercity", "Chaos Egg")) return;

    // 350: The King's Wings
    if (!storyKillQuest(350, "uppercity", "Terradactyl")) return;

    // 351: Bugging Out
    if (!storyKillQuest(351, "uppercity", "Rhino Beetle")) return;

    // 352: Lizard Gizzard
    if (!storyKillQuest(352, "uppercity", "Cave Lizard")) return;

    // 353: Mock the Lock
    if (!storyKillQuest(353, "dwarfprison", ["Balboa", "Chaos Drow", "Albino Bat"])) return;

    // 354: Like Butter
    if (!isCompletedBefore(354)) {
        if (!ensureMap("vath", "CutCap", "Left")) return;
        ensureMap("dwarfprison", "Enter", "Right");
        storyChainQuest(354);
        return;
    }

    // 355: Jailhouse Rock
    if (!storyKillQuest(355, "dwarfprison", "Warden Elfis")) return;

    // 356: Explosives 101
    if (!storyKillQuest(356, "dwarfprison", ["Albino Bat", "Balboa", "Chaos Drow"])) return;

    // 357: Big Bada-Boom
    if (!isCompletedBefore(357)) {
        storyChainQuest(357, "dwarfprison");
        return;
    }

    // 362: Defeat Rock Roc
    if (!storyMapItemQuest(362, "roc", 62)) return;

    // 363: Facing Vath
    if (!storyMapItemQuest(363, "stalagbite", 63)) return;
}
